<xpath expr="//form" position="inside">
    <app string="Construction Materials AI" name="construction_materials">
        <block title="Gemini API Configuration">

            <setting help="Configure your Google Gemini API Key">
                <field name="construction_api_key"
                       password="True"
                       placeholder="Enter your Gemini API Key"/>
                <div class="text-muted">
                    Get your free API key at:
                    https://aistudio.google.com/api-keys
                </div>
            </setting>

            <setting help="Select which AI Agent will handle the assistant">
                <field name="construction_agent_id"
                       options="{'no_create': True}"/>
            </setting>

        </block>
    </app>
</xpath>
