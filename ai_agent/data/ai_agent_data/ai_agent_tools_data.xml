<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_ai_inventory_detail" model="ir.actions.server">
            <field name="name">Consultar Detalle de Producto</field>
            <field name="model_id" ref="model_ai_tools_inv"/>
            <field name="state">code</field>
            <field name="ai_tool_schema">
{"type": "object",
"properties": {
    "product_name": {
        "type": "string",
        "description": "Nombre o referencia del producto a buscar",
        "maxLength": 600
    }
},
"required": ["product_name"]}
            </field>
            <field name="code">
ai['result'] = model.get_product_detail(product_name)
            </field>
            <field name="use_in_ai" eval="True"/>
        </record>


    </data>
</odoo>
