<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_agent.ProductCard">
        <div class="o_ai_product_card border rounded p-2 d-flex align-items-center bg-light shadow-sm">
            <img t-att-src="product.image_url" class="rounded me-3" style="width: 64px; height: 64px; object-fit: cover;"/>
            <div class="flex-grow-1">
                <h6 class="mb-1" t-att-title="product.name"><t t-esc="product.name"/></h6>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge rounded-pill bg-primary"><t t-esc="product.price"/> USD</span>
                    <small class="text-muted">Stock: <t t-esc="product.stock"/></small>
                </div>
                <button class="btn btn-sm btn-outline-secondary mt-2 w-100" t-on-click="onViewProduct">
                    Ver Detalles
                </button>
            </div>
        </div>
    </t>
</templates>