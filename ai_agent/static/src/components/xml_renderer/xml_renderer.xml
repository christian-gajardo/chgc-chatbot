<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_agent.XmlRenderer">
        <div class="o_ai_xml_renderer p-2 border rounded shadow-sm bg-light mt-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted fw-bold">XML Preview</small>
            </div>
            <pre class="m-0 p-2 bg-dark text-white rounded overflow-auto" style="max-height: 300px; font-size: 0.85rem;">
                <code t-esc="formattedXml"/>
            </pre>
        </div>
    </t>
</templates>
