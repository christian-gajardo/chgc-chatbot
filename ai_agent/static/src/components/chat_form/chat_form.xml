<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_agent.ChatForm">
        <div class="o_ai_dynamic_form p-3 border rounded bg-white shadow-sm">
            <div t-foreach="props.fields" t-as="field" t-key="field.name" class="mb-3">
                <label t-att-for="field.name" class="form-label fw-bold" t-esc="field.label"/>
                
                <input 
                    t-att-type="field.type || 'text'"
                    t-att-name="field.name"
                    class="form-control"
                    t-att-value="state.formData[field.name]"
                    t-on-input="(ev) => this.onInputChange(field.name, ev.target.value)"
                    t-att-disabled="state.submitted"
                />
            </div>
            
            <button 
                class="btn btn-primary w-100" 
                t-on-click="_onSubmitForm"
                t-att-disabled="state.submitted">
                <t t-if="!state.submitted">Enviar Información</t>
                <t t-else="">Enviado con éxito ✓</t>
            </button>
        </div>
    </t>
</templates>