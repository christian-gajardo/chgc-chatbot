<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_agent.ProductCard">
        <div class="o_ai_product_card d-flex align-items-center p-2 border rounded shadow-sm bg-white">
            <img t-att-src="props.data.image_url" class="rounded me-3" style="width: 64px; height: 64px; object-fit: cover;"/>
            <div class="flex-grow-1">
                <h6 class="mb-1 text-primary"><t t-esc="props.data.name"/></h6>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge rounded-pill bg-info text-dark">
                        Stock: <t t-esc="props.data.qty"/>
                    </span>
                    <strong class="text-success"><t t-esc="props.data.price"/></strong>
                </div>
            </div>
        </div>
    </t>
</templates>