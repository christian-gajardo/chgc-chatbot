<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="a2ui.ProductCard" owl="1">
        <div class="o_a2ui_card border rounded p-3 shadow-sm bg-white mb-2" style="max-width: 250px;">
            <div class="fw-bold text-primary mb-2">
                <t t-esc="props.data.name"/>
            </div>
            <div class="d-flex justify-content-between border-top pt-2">
                <span>Stock:</span>
                <span t-attf-class="badge #{props.data.qty > 0 ? 'bg-success' : 'bg-danger'}">
                    <t t-esc="props.data.qty"/>
                </span>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <span>Precio:</span>
                <span class="fw-bold"><t t-esc="props.data.price"/> <t t-esc="props.data.currency"/></span>
            </div>
            <button class="btn btn-sm btn-outline-secondary w-100 mt-3" 
                    t-on-click="() => props.onOpen(props.data.id)">
                Ver Producto
            </button>
        </div>
    </t>
</templates>