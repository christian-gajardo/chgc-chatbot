<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mi_modulo_a2ui.ChatForm">
        <div class="o_ai_form_container shadow-sm p-3 m-2 bg-white rounded border">
            <t t-if="!state.submitted">
                <h6 class="border-bottom pb-2">Formulario de IA</h6>
                <form t-on-submit.prevent="_onSubmitForm">
                    <t t-foreach="props.fields" t-as="field" t-key="field.name">
                        <div class="mb-2">
                            <label class="small fw-bold" t-esc="field.label"/>
                            <input t-att-type="field.type" 
                                   t-att-name="field.name" 
                                   class="form-control form-control-sm"
                                   t-on-input="onInputChange"/>
                        </div>
                    </t>
                    <button type="submit" class="btn btn-primary btn-sm w-100 mt-2">Enviar</button>
                </form>
            </t>
            <t t-else="">
                <div class="text-success small">
                    <i class="fa fa-check-circle"/> Datos enviados al sistema.
                </div>
            </t>
        </div>
    </t>
</templates>