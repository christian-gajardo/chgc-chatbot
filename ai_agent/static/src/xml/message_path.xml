<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-body')]" position="replace">
            <div class="o-mail-Message-body">
                <t t-if="isA2UIForm">
                    <div class="a2ui-dynamic-form border rounded p-3 mt-2 bg-white shadow-sm" style="max-width: 300px;">
                        <h6 class="text-primary mb-3"><i class="fa fa-wpforms me-2"/>Nuevo Registro</h6>
                        
                        <div t-foreach="a2uiFormData.fields" t-as="field" t-key="field.name" class="mb-3">
                            <label class="form-label small fw-bold" t-esc="field.label"/>
                            <input t-att-type="field.type" 
                                   t-att-name="field.name" 
                                   class="form-control form-control-sm" 
                                   t-att-placeholder="'Ingrese ' + field.label.toLowerCase()"/>
                        </div>
                        
                        <button class="btn btn-primary btn-sm w-100 mt-2" t-on-click="() => console.log('Datos listos para enviar')">
                            Guardar Datos
                        </button>
                    </div>
                </t>
                <t t-else="">
                    <t t-out="props.message.body"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>