<patch t-inherit="mail.Message" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o-mail-Message-body')]" position="inside">
        <t t-if="isForm">
            <div class="a2ui-dynamic-form">
                <t t-foreach="formData.fields" t-as="field" t-key="field.name">
                    <label t-esc="field.label"/>
                    <input t-att-type="field.type" t-att-name="field.name" class="form-control"/>
                </t>
                <button class="btn btn-primary mt-2">Enviar Registro</button>
            </div>
        </t>
    </xpath>
</patch>